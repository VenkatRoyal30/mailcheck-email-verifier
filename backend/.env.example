# ==============================================================================
# MailCheck Backend — Environment Configuration Template
# ==============================================================================

SECRET_KEY=replace-with-a-cryptographically-secure-random-secret
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

DATABASE_URL=sqlite:///mailcheck.db
# DATABASE_URL=postgresql://postgres_user:strong_password@db_host:5432/mailcheck_db

MAX_BATCH_SIZE=100
DNS_TIMEOUT=3.0
SMTP_TIMEOUT=5.0
ENABLE_SMTP_BY_DEFAULT=false
RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


