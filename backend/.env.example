# ==============================================================================
# MailCheck Backend — Environment Configuration Template
# ==============================================================================

SECRET_KEY=replace-with-a-cryptographically-secure-random-secret
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# SQLite (Default):
DATABASE_URL=sqlite:///mailcheck.db
# PostgreSQL (Production on Render):
# DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a:5432/mailcheck_db

MAX_BATCH_SIZE=100
DNS_TIMEOUT=3.0
SMTP_TIMEOUT=5.0
ENABLE_SMTP_BY_DEFAULT=false
RETENTION_DAYS=30
CORS_ORIGINS=*



