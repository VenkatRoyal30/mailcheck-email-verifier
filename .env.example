# ==============================================================================
# MailCheck SaaS — Environment Configuration Template
# Copy this file to .env before starting the backend application in production.
# Never commit active credentials, production secrets, or private keys.
# ==============================================================================

# Flask Server Configuration
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret
FLASK_DEBUG=0
PORT=5000
HOST=127.0.0.1

# Database Connection
# SQLite (Local Development default):
DATABASE_URL=sqlite:///mailcheck.db
# PostgreSQL (Production Deployment):
# DATABASE_URL=postgresql://postgres_user:strong_password@db_host:5432/mailcheck_db

# Verification Pipeline Thresholds
MAX_BATCH_SIZE=100
DNS_TIMEOUT=3.0
SMTP_TIMEOUT=5.0
ENABLE_SMTP_BY_DEFAULT=false

# Data Retention Policy (Days)
RETENTION_DAYS=30

# CORS Allowed Origins (Comma-separated origins or *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

