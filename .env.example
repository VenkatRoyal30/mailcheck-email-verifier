# ==============================================================================
# MailCheck SaaS — Environment Configuration Template
# Copy this file to .env before starting the backend application locally.
# On Render, configure these environment variables in the Render Dashboard.
# Never commit active credentials, production secrets, or private keys.
# ==============================================================================

# Flask Server Configuration
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret
FLASK_DEBUG=0
# PORT is automatically injected by Render in production (e.g. 10000). Defaults to 5000 locally.
PORT=5000
# HOST binds to 0.0.0.0 in cloud deployments.
HOST=0.0.0.0

# Database Connection
# SQLite (Local Development and Render Free Tier quick-start):
# When DATABASE_URL is not set, MailCheck defaults to a local SQLite database file.
# Note: On Render Free Web Services, local disk storage is ephemeral.
DATABASE_URL=sqlite:///mailcheck.db

# PostgreSQL (Production Persistent Storage on Render):
# If using Render PostgreSQL, paste the Internal Database URL:
# DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a:5432/mailcheck_db

# Verification Pipeline Thresholds
MAX_BATCH_SIZE=100
DNS_TIMEOUT=3.0
SMTP_TIMEOUT=5.0
ENABLE_SMTP_BY_DEFAULT=false

# Data Retention Policy (Days)
RETENTION_DAYS=30

# CORS Allowed Origins (Set to * or your custom production domain)
CORS_ORIGINS=*


